{
  "expo": {
    "name": "BaytiBite",
    "slug": "baytibite",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "baytibite",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EC"
        }
      ]
    ],
    "android": {
      "package": "com.baytibite.app"
    },
    "ios": {
      "bundleIdentifier": "com.baytibite.app"
    }
  }
}
